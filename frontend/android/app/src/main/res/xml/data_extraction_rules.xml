<?xml version="1.0" encoding="utf-8"?>
<!--
  The app stores a bearer session for its server. allowBackup="false" stops
  cloud and adb backup, but Android 12+ still copies app data in a
  device-to-device transfer unless these rules exclude it. Nothing here is
  worth restoring without signing in again.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
