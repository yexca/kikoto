{
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "cap:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "apk:debug": "npm run cap:sync && cd android && gradlew.bat --dependency-verification strict assembleDebug",
    "docs:check-links": "node ../scripts/check-doc-links.mjs",
    "lint": "eslint src --max-warnings=0",
    "format:check": "prettier --check --end-of-line auto \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"../scripts/**/*.mjs\" \"public/**/*.js\" \"*.{ts,mjs,cjs}\"",
    "preview": "vite preview --host 127.0.0.1",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.spec.ts",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile-chromium"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@radix-ui/react-slot": "^1.3.0",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hls.js": "^1.6.13",
    "i18next": "^25.10.10",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.6.6",
    "tailwind-merge": "2.6.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "4.1.10",
    "autoprefixer": "^10.5.2",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "postcss": "^8.5.23",
    "prettier": "^3.9.5",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.0.1",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents": false
  }
}
