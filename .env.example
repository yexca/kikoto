# Copy to .env beside docker-compose.yml and replace the root password.
# Shell environment variables override .env; unset or empty optional values use Compose defaults.
KIKOTO_IMAGE=yexca/kikoto:latest

# Runtime mode: development (root auth bypass), production (normal auth), or demo (isolated read-only showcase).
KIKOTO_MODE=production
KIKOTO_ROOT_USERNAME=root
KIKOTO_ROOT_PASSWORD=replace-with-a-long-random-password

KIKOTO_HTTP_ADDR=0.0.0.0:7659
# Container paths, not host mount paths. Keep durable state under /config and /data.
# Changing these does not change Compose volumes; /app/static contains the bundled frontend.
KIKOTO_DB_PATH=/config/kikoto.db
KIKOTO_DATA_ROOT=/data
KIKOTO_CACHE_ROOT=/cache
KIKOTO_STATIC_DIR=/app/static
KIKOTO_LOCAL_SCAN_DEPTH=3
KIKOTO_SESSION_COOKIE_SECURE=false
# Optional comma-separated exact origins for a separately hosted frontend.
# Same-origin Docker/Vite proxy setups should leave this empty.
KIKOTO_ALLOWED_ORIGINS=
# Optional comma-separated reverse-proxy IP addresses or CIDR prefixes. Only these
# peers may supply X-Forwarded-For for sign-in throttling; leave empty without a proxy.
KIKOTO_TRUSTED_PROXIES=
# Maximum concurrent password checks. Each check uses about 19 MiB of memory.
KIKOTO_LOGIN_CONCURRENCY=8

# Optional first-run remote source seed. Compose reads config/remote-sources.yml from /config.
# It is ignored once any remote source exists in the database.
KIKOTO_REMOTE_SOURCES_ENABLED=false
